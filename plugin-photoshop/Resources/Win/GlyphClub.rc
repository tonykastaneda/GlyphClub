// Windows resources for GlyphClub.8li: the PiPL (the same PiPLs.json the Mac
// bundle carries, as the JSON_PIPL resource Photoshop looks for) and version
// info, whose ProductVersion GlyphClub reads (src/integrations.rs).
#include <windows.h>
#include "GlyphClubPsVersion.h"

JSON_PIPL JSON "PiPLs.json"

1 VERSIONINFO
 FILEVERSION GLYPHCLUB_PS_VERSION_COMMAS
 PRODUCTVERSION GLYPHCLUB_PS_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GlyphClub"
            VALUE "FileDescription", "GlyphClub - activates missing fonts in Photoshop"
            VALUE "FileVersion", GLYPHCLUB_PS_VERSION_STRING
            VALUE "InternalName", "GlyphClub"
            VALUE "OriginalFilename", "GlyphClub.8li"
            VALUE "ProductName", "GlyphClub"
            VALUE "ProductVersion", GLYPHCLUB_PS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
