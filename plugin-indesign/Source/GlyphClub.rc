// Windows: GlyphClub.pln's version info (GlyphClub reads ProductVersion to
// tell an older installed copy, src/integrations.rs). The plug-in's own
// resources come from GlyphClub.fr, compiled by ODFRC and merged in by the
// SDK's merge_res.cmd (win/GlyphClub.sdk.vcxproj).
#include <windows.h>
#include "GCVersion.h"

1 VERSIONINFO
 FILEVERSION GLYPHCLUB_ID_VERSION_COMMAS
 PRODUCTVERSION GLYPHCLUB_ID_VERSION_COMMAS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GlyphClub"
            VALUE "FileDescription", "GlyphClub - activates missing fonts in InDesign"
            VALUE "FileVersion", GLYPHCLUB_ID_VERSION
            VALUE "InternalName", "GlyphClub"
            VALUE "OriginalFilename", "GlyphClub.pln"
            VALUE "ProductName", "GlyphClub"
            VALUE "ProductVersion", GLYPHCLUB_ID_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
